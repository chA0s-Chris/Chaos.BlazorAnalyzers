<Project>
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>

    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>

    <PreferredUILang>en</PreferredUILang>
  </PropertyGroup>

  <!-- The release workflow overrides Version from the tag it builds; the value here is
       what a local build stamps into the assembly and package. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Product>Chaos.BlazorAnalyzers</Product>
    <Authors>Christian Flessa</Authors>
    <Company>Christian Flessa</Company>
    <Copyright>Copyright (c) 2026 Christian Flessa</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/chA0s-Chris/Chaos.BlazorAnalyzers</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/chA0s-Chris/Chaos.BlazorAnalyzers</RepositoryUrl>
  </PropertyGroup>
</Project>
